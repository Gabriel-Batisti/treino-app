# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Dados exportados — não versionar (crescem sem limite e é dado pessoal).
# Durabilidade offsite = copiar a pasta pro OneDrive, não commitar.
backups/
# Arquivos de entrada (export do Heavy, seeds baixados).
# Não versionar: dado pessoal e arquivos grandes.
data/
